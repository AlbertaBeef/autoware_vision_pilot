{
  "inputs": {
    "input": [
      1,
      3,
      320,
      640
    ]
  },
  "calibration_num": 200,
  "calibration_method": "minmax",
  "default_loader": {
    "dataset_path": "Models/exports/deepx/SceneSegLite_calib",
    "file_extensions": [
      "jpeg",
      "jpg",
      "png",
      "JPEG",
      "PNG"
    ],
    "preprocessings": [
      {
        "convertColor": {
          "form": "BGR2RGB"
        }
      },
      {
        "resize": {
          "width": 640,
          "height": 320
        }
      },
      {
        "div": {
          "x": 255.0
        }
      },
      {
        "normalize": {
          "mean": [
            0.485,
            0.456,
            0.406
          ],
          "std": [
            0.229,
            0.224,
            0.225
          ]
        }
      },
      {
        "transpose": {
          "axis": [
            2,
            0,
            1
          ]
        }
      },
      {
        "expandDim": {
          "axis": 0
        }
      }
    ]
  }
}